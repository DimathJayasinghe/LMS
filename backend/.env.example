# Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Database (self-hosted Postgres in Docker Compose; in-container host is `postgres`).
# For a fully offline setup copy `.env.local.example` instead (see context/documents/16-local-development.md).
DATABASE_URL=postgresql://user:password@postgres:5432/dbname?schema=public
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Provider drivers: leave at the real providers for staging/production (local drivers are refused when NODE_ENV=production)
STORAGE_DRIVER=r2
SMS_DRIVER=notify

# Redis (self-hosted in Docker Compose; in-container use redis://redis:6379)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_REUSE_GRACE_SECONDS=10

# Initial Super Admin (used by the seed script)
LMS_ADMIN_EMAIL=admin@lms.com
LMS_ADMIN_PASSWORD=change-me

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BUCKET_NAME=
R2_PUBLIC_URL=
# Only for STORAGE_DRIVER=local: browser-visible endpoint used to sign presigned URLs
R2_PRESIGN_ENDPOINT=

# Bunny.net
BUNNY_API_KEY=
# Required in production: read-only API key used to verify webhook signatures.
BUNNY_READ_ONLY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=
# Required in production: library Token Authentication Key for playback URLs.
BUNNY_TOKEN_KEY=
# Unused legacy setting, retained for compatibility with existing env files.
BUNNY_WEBHOOK_SECRET=

# Zoom
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

# PayHere
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_BASE_URL=https://sandbox.payhere.lk
PAYHERE_RETURN_URL=
PAYHERE_CANCEL_URL=
PAYHERE_NOTIFY_URL=

# Notify.lk (SMS)
NOTIFY_SEND_URL=https://app.notify.lk/api/v1/send
NOTIFY_API_KEY=
NOTIFY_USER_ID=
NOTIFY_SENDER_ID=

# Sentry (optional — crash reporting is disabled if empty)
SENTRY_DSN=

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# ── ngrok dev tunnel (docker-compose `ngrok` service; dev only) ───────────────
# Exposes the local stack publicly so Bunny/Zoom/PayHere webhooks can reach it.
# Required: authtoken → https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional: reserved free static domain for a stable URL across restarts.
# Full https URL, e.g. https://your-name.ngrok-free.app
NGROK_DOMAIN=
