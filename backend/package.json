{
  "name": "lms-backend",
  "version": "1.0.0",
  "description": "Academic LMS Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "prisma": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "owner:add": "node dist/scripts/owner-add.js",
    "owner:reset-password": "node dist/scripts/owner-reset-password.js",
    "scan-codes:report": "tsx src/scripts/report-scan-code-collisions.ts"
  },
  "keywords": [],
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.11.10",
    "eslint": "^10.8.1",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.892.0",
    "@aws-sdk/s3-request-presigner": "^3.892.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/node": "^10.70.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.77.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-http": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "rate-limit-redis": "^5.0.0",
    "read-excel-file": "^9.3.10",
    "sharp": "0.35.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1"
  }
}
