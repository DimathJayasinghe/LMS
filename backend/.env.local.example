# LOCAL, offline development env. Everything runs in Docker; no external accounts needed.
#   cp backend/.env.local.example backend/.env
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build
# See context/documents/16-local-development.md. NEVER copy these values to production.

NODE_ENV=development
PORT=5000

# Postgres container (read by the postgres service and by the backend)
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms-local-password
POSTGRES_DB=lms
DATABASE_URL=postgresql://lms:lms-local-password@postgres:5432/lms?schema=public

REDIS_URL=redis://redis:6379

# Local-only secrets (>= 16 chars). Generate new ones for any shared environment.
JWT_ACCESS_SECRET=local-access-secret-change-me
JWT_REFRESH_SECRET=local-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seeded super admin (created on first backend start)
LMS_ADMIN_EMAIL=admin@lms.local
LMS_ADMIN_PASSWORD=ChangeMe-Local-1

FRONTEND_URL=http://localhost

# Provider drivers. The compose overlay also sets these; they are listed here so the
# backend can be run directly on the host against the same containers (Option B in README).
STORAGE_DRIVER=local
SMS_DRIVER=log
# Host-side values (when the backend runs on your machine, not in Docker):
# R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=lmsdev
R2_SECRET_ACCESS_KEY=lmsdev-secret-key
R2_BUCKET_NAME=lms-private
R2_PUBLIC_BUCKET_NAME=lms-public
R2_PUBLIC_URL=http://localhost:9000/lms-public
