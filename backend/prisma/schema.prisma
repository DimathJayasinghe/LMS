// Prisma schema — source of truth: context/documents/08-database-design.md
// Datasource URL is supplied by prisma.config.ts (env DATABASE_URL); the runtime
// client uses the pg driver adapter (see src/config/database.ts).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── ENUMS ───────────────────────────────

enum Role {
  SUPER_ADMIN // institution owner (exactly one)
  TEACHER // lecturer (many) — owns their courses
  ADMIN // front-desk staff (many)
  MARKER // grades assigned exams
  STUDENT
}

enum ClassType {
  ONLINE
  PHYSICAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE // PayHere
  ENTRANCE // paid in person at the front desk
  BULK // Excel import
  MANUAL // owner/admin adjustment
}

enum PaymentAdjustmentType {
  OVERRIDE
  REFUND
}

enum SubmissionStatus {
  UPLOADING
  COMPLETED
}

// Lifecycle of a direct-to-Bunny video upload. UPLOADING → READY is driven by
// Bunny's webhook (Status 4 "Finished"), never by the client — see bunny.ts.
enum VideoStatus {
  UPLOADING
  READY
  FAILED
}

enum CourseModuleStatus {
  DRAFT
  PUBLISHED
}

enum CourseMaterialType {
  FILE
}

enum AttendanceSource {
  QR // student QR scanned at the entrance
  BARCODE // physical barcode card
  ZOOM_WEBHOOK // live-streamed class join
  MANUAL // admin entry
}

enum SmsStatus {
  PENDING
  SENT
  FAILED
}

enum ExamType {
  MCQ
  WRITTEN
  HYBRID
  INCLASS
}

enum ExamAudienceDeliveryMode {
  ONLINE
  PHYSICAL
}

enum MarkerGroupScope {
  COURSE
  SUBJECT
  INSTITUTE
}

enum MarkerGroupMembershipAction {
  ADDED
  REMOVED
}

// Scenarios that can fire a notification. Add new values here as new triggers
// ship — NotificationSettingService seeds a row per (type, channel) on demand.
enum NotificationType {
  RESULTS_PUBLISHED
  PAYMENT_CONFIRMED
  PAYMENT_OVERRIDDEN
}

// EMAIL deliberately omitted — no email-sending infra exists yet (see Progress
// Tracker Decisions Log, "Email out of scope for v1"). Add it here when it does.
enum NotificationChannel {
  IN_APP
  SMS
}

// ─────────────────────────────── IDENTITY ───────────────────────────────

model User {
  id          String    @id @default(uuid())
  indexNumber Int       @unique @default(autoincrement())
  email       String    @unique
  name        String
  nic         String?   @unique
  phone       String?
  address     String?
  city        String?
  password    String
  barcode     String?   @unique // LMS-issued QR code (global) — LMS-native entrance
  role        Role      @default(STUDENT)
  deletedAt   DateTime?

  // Account setup / onboarding
  setupCompleted Boolean @default(false)
  nicFrontUrl    String? // R2 key — NIC front photo (private)
  nicBackUrl     String? // R2 key — NIC back photo (private)

  // Profile
  profileImage      String? // public CDN URL of the avatar (public bucket)
  emailChangedAt    DateTime? // cooldown anchor — self email changes
  passwordChangedAt DateTime? // cooldown anchor — self password changes

  permission                        Permission?                  @relation("UserPermission")
  enrollments                       Enrollment[]
  taughtCourses                     Course[]                     @relation("CourseTeacher") // courses this TEACHER teaches
  subjectAssignments                SubjectTeacher[]             @relation("SubjectTeacher")
  courseProgress                    CourseContentProgress[]
  studentBarcodes                   StudentBarcode[] // per-institute barcodes
  attendance                        Attendance[]
  submissions                       Submission[]
  actorAuditLogs                    AuditLog[]                   @relation("AuditActor")
  markerAssignments                 MarkerAssignment[]           @relation("AssignedMarker")
  markerAllocationRevisions         MarkerAllocationRevision[]   @relation("MarkerAllocationActor")
  markerGroupsCreated               MarkerGroup[]                @relation("MarkerGroupCreator")
  markerGroupMembershipsAdded       MarkerGroupMember[]          @relation("MarkerGroupMemberAddedBy")
  markerGroupMembershipsRemoved     MarkerGroupMember[]          @relation("MarkerGroupMemberRemovedBy")
  markerGroupMembershipEvents       MarkerGroupMembershipEvent[] @relation("MarkerGroupMembershipEventActor")
  markerGroupMembers                MarkerGroupMember[]
  markerGroupMembershipEventMarkers MarkerGroupMembershipEvent[]
  examPapersCreated                 ExamPaper[]                  @relation("ExamPaperCreator")
  examParticipants                  ExamParticipant[]
  collectedPayments                 Payment[]                    @relation("PaymentCollector") // ENTRANCE/MANUAL payments taken
  paymentAdjustments                PaymentAdjustment[]          @relation("PaymentAdjustmentActor")
  smsLogs                           SmsLog[]
  notifications                     Notification[]
  refreshTokens                     RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([nic])
  @@index([barcode])
  @@index([role])
}

model Permission {
  id          String @id @default(uuid())
  permissions Json // fine-grained overrides on top of role, e.g. { "createExam": true }

  userId String @unique
  user   User   @relation("UserPermission", fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique // SHA-256 hash of the refresh token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model IdempotencyRecord {
  id           String   @id @default(uuid())
  key          String   @unique
  route        String
  responseCode Int
  responseBody Json
  createdAt    DateTime @default(now())

  @@index([key])
  @@index([createdAt])
}

// ─────────────────────────── ACADEMIC HIERARCHY ───────────────────────────

model Subject {
  id          String  @id @default(uuid())
  name        String  @unique // Physics, Chemistry, Combined Maths
  description String?
  isActive    Boolean @default(true)

  courses            Course[]
  teacherAssignments SubjectTeacher[]
  markerGroups       MarkerGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Course {
  id          String  @id @default(uuid())
  name        String
  year        Int
  description String?
  monthlyFee  Decimal @db.Decimal(10, 2)
  isActive    Boolean @default(true)

  // Display assets shown on the course page / dashboard
  bannerUrl   String? // server-controlled public URL
  bannerKey   String? // public R2 object key for lifecycle management
  bannerAlt   String? // accessible description
  backdropUrl String? // server-controlled public URL
  backdropKey String? // public R2 object key for lifecycle management
  backdropAlt String? // accessible description

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  teacherId String
  teacher   User   @relation("CourseTeacher", fields: [teacherId], references: [id], onDelete: Restrict)

  enrollments     Enrollment[]
  classSessions   ClassSession[]
  exams           Exam[]
  examPapers      ExamPaper[]
  timetableSlots  TimetableSlot[]
  contentProgress CourseContentProgress[]
  modules         CourseModule[]
  markerGroups    MarkerGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, name, year])
  @@index([subjectId])
  @@index([teacherId])
  @@index([year])
  @@index([isActive])
}

// SUPER_ADMIN-controlled teaching scope. A teacher may create courses only
// inside subjects assigned here; existing Course ownership is backfilled into
// this table by the additive migration.
model SubjectTeacher {
  id String @id @default(uuid())

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  teacherId String
  teacher   User   @relation("SubjectTeacher", fields: [teacherId], references: [id], onDelete: Restrict)

  assignedAt DateTime @default(now())

  @@unique([subjectId, teacherId])
  @@index([subjectId])
  @@index([teacherId])
}

// Student-specific read marker for course content. Absence means the student
// has not opened the course since enrolling; opening it upserts lastSeenAt.
model CourseContentProgress {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  lastSeenAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

// Ordered learning units. Students only receive PUBLISHED modules whose
// releaseAt is absent or has passed; staff management remains ownership-scoped.
model CourseModule {
  id          String             @id @default(uuid())
  title       String
  description String?
  position    Int
  status      CourseModuleStatus @default(DRAFT)
  releaseAt   DateTime?
  deletedAt   DateTime?

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  materials CourseMaterial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, position])
  @@index([courseId, status, releaseAt])
  @@index([deletedAt])
}

// Private R2-backed resources. objectKey is never exposed in list responses;
// downloads are authorized server-side and receive only a short-lived URL.
model CourseMaterial {
  id           String             @id @default(uuid())
  type         CourseMaterialType @default(FILE)
  title        String
  description  String?
  position     Int
  objectKey    String?            @unique
  fileName     String?
  contentType  String?
  sizeBytes    Int?
  downloadable Boolean            @default(true)
  version      Int                @default(1)
  deletedAt    DateTime?

  moduleId String
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId, position])
  @@index([deletedAt])
}

model Enrollment {
  id        String    @id @default(uuid())
  classType ClassType
  isActive  Boolean   @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId, classType])
  @@index([userId])
  @@index([courseId])
  @@index([classType])
}

model Payment {
  id             String        @id @default(uuid())
  amount         Decimal       @db.Decimal(10, 2)
  status         PaymentStatus @default(PENDING)
  method         PaymentMethod @default(ONLINE)
  payhereId      String?       @unique
  paymentMonth   String
  note           String?
  refundedAmount Decimal       @default(0) @db.Decimal(10, 2)

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  collectedById String? // staff who took an ENTRANCE/MANUAL payment
  collectedBy   User?   @relation("PaymentCollector", fields: [collectedById], references: [id], onDelete: SetNull)

  collectedAtInstituteId String?
  collectedAtInstitute   Institute? @relation(fields: [collectedAtInstituteId], references: [id], onDelete: SetNull)
  collectedViaBarcode    String? // raw barcode value that identified the student — a
  // point-in-time snapshot, not a live FK, since
  // StudentBarcode rows can be hard-deleted later
  // and this must stay a stable audit fact

  adjustments PaymentAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, paymentMonth])
  @@index([enrollmentId])
  @@index([status])
  @@index([method])
  @@index([paymentMonth])
  @@index([collectedAtInstituteId])
}

model PaymentAdjustment {
  id                  String                @id @default(uuid())
  type                PaymentAdjustmentType
  amount              Decimal?              @db.Decimal(10, 2)
  statusBefore        PaymentStatus
  statusAfter         PaymentStatus
  paymentAmountBefore Decimal               @db.Decimal(10, 2)
  paymentAmountAfter  Decimal               @db.Decimal(10, 2)
  reason              String
  externalReference   String?

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("PaymentAdjustmentActor", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([paymentId, createdAt])
  @@index([createdById])
  @@index([type])
}

model ClassSession {
  id              String     @id @default(uuid())
  title           String
  description     String?
  classType       ClassType? // null = all cohorts (e.g. physical + streamed online)
  date            DateTime
  durationMinutes Int        @default(60)
  zoomLink        String? // present = live-streamed; the Zoom join_url once scheduled through the site
  zoomMeetingId   String?
  zoomPassword    String? // set when WE create the meeting (self-service scheduling) — needed by every joiner

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  // Set when this session was generated from a recurring timetable slot.
  timetableSlotId String?
  timetableSlot   TimetableSlot? @relation(fields: [timetableSlotId], references: [id], onDelete: SetNull)

  deletedAt DateTime?

  attendance      Attendance[]
  videoRecordings VideoRecording[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([timetableSlotId, date]) // idempotent generation: one session per slot per occurrence
  @@index([courseId])
  @@index([courseId, classType])
  @@index([date])
  @@index([deletedAt])
}

model Attendance {
  id         String           @id @default(uuid())
  source     AttendanceSource @default(QR)
  scannedAt  DateTime         @default(now())
  lastSeenAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  classSessionId String
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, classSessionId])
  @@index([userId])
  @@index([classSessionId])
}

model VideoRecording {
  id              String      @id @default(uuid())
  title           String
  bunnyVideoId    String
  durationSeconds Int?
  // UPLOADING until Bunny's webhook confirms processing finished — see
  // VideoStatus below. Videos attached via the legacy manual (already-on-Bunny)
  // flow are created straight into READY.
  status          VideoStatus @default(UPLOADING)

  classSessionId String
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classSessionId])
  @@index([bunnyVideoId])
}

model Exam {
  id          String   @id @default(uuid())
  title       String
  type        ExamType @default(HYBRID)
  paperPdfUrl String? // R2 URL — the written (structured/essay) question paper
  mcqPayload  Json? // MCQ section (null = no MCQ section)

  // Which answer channels students may use (exam-wide; online + physical alike)
  allowTypedAnswers Boolean @default(true) // type structured/essay answers online
  allowPdfUpload    Boolean @default(true) // upload a scanned/written A4 answer PDF

  startTime   DateTime
  endTime     DateTime
  totalMarks  Int      @default(100)
  isPublished Boolean  @default(false)

  // Null keeps the complete legacy whole-course exam contract. A non-null
  // revision turns this into a scoped instance with explicit audiences/roster.
  paperRevisionId  String?
  paperRevision    ExamPaperRevision? @relation(fields: [paperRevisionId], references: [id], onDelete: Restrict)
  audienceRevision Int                @default(0)
  rosterRevision   Int                @default(0)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  deletedAt DateTime?

  submissions       Submission[]
  markerAssignments MarkerAssignment[]
  markerAssignmentAudiences MarkerAssignmentAudience[]
  markerAllocationRevisions MarkerAllocationRevision[]
  audiences         ExamAudience[]
  participants      ExamParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([startTime])
  @@index([endTime])
  @@index([deletedAt])
  @@index([type])
  @@index([paperRevisionId])
}

model ExamPaper {
  id          String              @id @default(uuid())
  title       String
  courseId    String
  course      Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   User                @relation("ExamPaperCreator", fields: [createdById], references: [id], onDelete: Restrict)
  revisions   ExamPaperRevision[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([courseId])
  @@index([createdById])
}

model ExamPaperRevision {
  id                String    @id @default(uuid())
  paperId           String
  paper             ExamPaper @relation(fields: [paperId], references: [id], onDelete: Restrict)
  version           Int
  type              ExamType
  totalMarks        Int
  paperPdfUrl       String?
  mcqPayload        Json?
  allowTypedAnswers Boolean   @default(true)
  allowPdfUpload    Boolean   @default(true)
  instances         Exam[]
  createdAt         DateTime  @default(now())

  @@unique([paperId, version])
  @@index([paperId])
}

model ExamAudience {
  id           String                   @id @default(uuid())
  examId       String
  exam         Exam                     @relation(fields: [examId], references: [id], onDelete: Restrict)
  label        String
  deliveryMode ExamAudienceDeliveryMode
  instituteId  String?
  institute    Institute?               @relation(fields: [instituteId], references: [id], onDelete: Restrict)
  participants ExamParticipant[]
  markerAssignmentAudiences MarkerAssignmentAudience[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([id, examId])
  @@index([examId])
  @@index([instituteId])
}

model ExamParticipant {
  id         String       @id @default(uuid())
  examId     String
  audienceId String
  userId     String
  exam       Exam         @relation(fields: [examId], references: [id], onDelete: Restrict)
  audience   ExamAudience @relation(fields: [audienceId, examId], references: [id, examId], onDelete: Restrict)
  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt  DateTime     @default(now())

  @@unique([examId, userId])
  @@index([audienceId, examId])
  @@index([userId])
}

model Submission {
  id             String           @id @default(uuid())
  status         SubmissionStatus @default(UPLOADING)
  answerPdfUrl   String? // R2 URL — uploaded PDF answer
  answers        Json? // MCQ selections — MCQ/HYBRID
  writtenAnswers Json? // typed essay/structured answers written online
  marks          Int? // null until graded
  feedback       String? // marker comments

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Restrict)

  submittedAt DateTime  @default(now())
  gradedAt    DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, examId])
  @@index([userId])
  @@index([examId])
  @@index([status])
}

model MarkerAssignment {
  id String @id @default(uuid())

  markerId String
  marker   User   @relation("AssignedMarker", fields: [markerId], references: [id], onDelete: Restrict)

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Restrict)

  assignedAt DateTime @default(now())
  allAudiences Boolean @default(false)

  // Scoped instances resolve every confirmed allocation to these exact,
  // audience-bound grants. Legacy instances intentionally retain their
  // whole-exam assignment without grant rows.
  audienceGrants MarkerAssignmentAudience[]

  @@unique([markerId, examId])
  @@unique([id, examId])
  @@index([markerId])
  @@index([examId])
}

model MarkerAssignmentAudience {
  id String @id @default(uuid())

  assignmentId String
  assignment MarkerAssignment @relation(fields: [assignmentId, examId], references: [id, examId], onDelete: Cascade)

  // `examId` is duplicated so PostgreSQL can bind the grant to an audience of
  // the same instance through the composite audience foreign key.
  examId String
  exam Exam @relation(fields: [examId], references: [id], onDelete: Restrict)
  audienceId String
  audience ExamAudience @relation(fields: [audienceId, examId], references: [id, examId], onDelete: Restrict)

  createdAt DateTime @default(now())
  source Json @default("[]")

  @@unique([assignmentId, audienceId])
  @@index([examId, audienceId])
}

// Immutable academic evidence for each confirmed scoped allocation. The JSON
// snapshots make revocation auditable without allowing historical group edits
// to alter confirmed marker/audience grants.
model MarkerAllocationRevision {
  id String @id @default(uuid())
  examId String
  exam Exam @relation(fields: [examId], references: [id], onDelete: Restrict)
  revision Int
  reason String
  digest String
  beforeState Json
  afterState Json
  sourceState Json @default("[]")
  evidenceState Json @default("{}")
  requestState Json @default("{}")
  idempotencyKey String?
  actorId String
  actor User @relation("MarkerAllocationActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([examId, revision])
  @@unique([examId, actorId, idempotencyKey])
  @@index([examId, createdAt])
  @@index([actorId])
}

// The migration enforces that every scope selects exactly one target relation.
model MarkerGroup {
  id          String           @id @default(uuid())
  name        String
  description String?
  scope       MarkerGroupScope
  isActive    Boolean          @default(true)
  deletedAt   DateTime?
  revision    Int              @default(0)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  instituteId String?
  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("MarkerGroupCreator", fields: [createdById], references: [id], onDelete: Restrict)

  members          MarkerGroupMember[]
  membershipEvents MarkerGroupMembershipEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([subjectId])
  @@index([instituteId])
  @@index([createdById])
  @@index([isActive])
  @@index([deletedAt])
}

// Removed membership rows remain available for reactivation; append-only events
// provide the historical record consumed by staff audit views.
model MarkerGroupMember {
  id String @id @default(uuid())

  groupId String
  group   MarkerGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  markerId String
  marker   User   @relation(fields: [markerId], references: [id], onDelete: Restrict)

  addedById String
  addedBy   User     @relation("MarkerGroupMemberAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  addedAt   DateTime @default(now())

  removedById String?
  removedBy   User?     @relation("MarkerGroupMemberRemovedBy", fields: [removedById], references: [id], onDelete: Restrict)
  removedAt   DateTime?

  @@unique([groupId, markerId])
  @@index([groupId])
  @@index([markerId])
  @@index([removedAt])
}

model MarkerGroupMembershipEvent {
  id     String                      @id @default(uuid())
  action MarkerGroupMembershipAction
  reason String

  groupId String
  group   MarkerGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  markerId String
  marker   User   @relation(fields: [markerId], references: [id], onDelete: Restrict)

  actorId String
  actor   User   @relation("MarkerGroupMembershipEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([groupId, createdAt])
  @@index([markerId])
  @@index([actorId])
}

model AuditLog {
  id          String  @id @default(uuid())
  action      String
  description String?
  targetType  String?
  targetId    String?
  metadata    Json?
  ip          String?
  userAgent   String?

  // Actor — the user who performed the action (any privileged role)
  actorId   String
  actor     User   @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorRole String // denormalized role at action time (historical accuracy)

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model SmsLog {
  id          String    @id @default(uuid())
  phoneNumber String
  message     String
  status      SmsStatus @default(PENDING)
  cost        Decimal?  @db.Decimal(6, 2)
  errorDetail String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// Per-user in-app notification inbox. Written by NotificationService.dispatch(),
// which also decides whether an SMS goes out for the same event based on
// NotificationSetting below. Read by the frontend bell (GET /notifications/me).
model Notification {
  id      String           @id @default(uuid())
  type    NotificationType
  title   String
  message String
  link    String? // optional deep link, e.g. /exams/:id
  isRead  Boolean          @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

// Super-admin-configurable on/off switch per (scenario, channel). One row per
// combination; NotificationSettingService seeds any missing combination as
// enabled=true on first read, so adding a new NotificationType never requires
// a manual data migration.
model NotificationSetting {
  id      String              @id @default(uuid())
  type    NotificationType
  channel NotificationChannel
  enabled Boolean             @default(true)

  updatedAt DateTime @updatedAt

  @@unique([type, channel])
}

// ─────────────────────── PHYSICAL INSTITUTES ───────────────────────

model Institute {
  id       String  @id @default(uuid())
  name     String  @unique // "Nugegoda Center"
  code     String  @unique // short code, e.g. "NUG"
  city     String?
  isActive Boolean @default(true)

  studentBarcodes StudentBarcode[]
  timetableSlots  TimetableSlot[]
  payments        Payment[]
  markerGroups    MarkerGroup[]
  examAudiences   ExamAudience[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ─────────────────────────── TIMETABLE ───────────────────────────
// A recurring weekly slot. A BullMQ job generates dated ClassSessions from
// active slots; cancellations/one-offs are handled as edits to those sessions.

model TimetableSlot {
  id              String     @id @default(uuid())
  title           String? // default title for generated sessions (falls back to course name)
  dayOfWeek       Int // 0=Sunday .. 6=Saturday (matches JS Date.getUTCDay())
  startTime       String // "HH:mm" local (Asia/Colombo)
  durationMinutes Int        @default(60)
  classType       ClassType? // ONLINE / PHYSICAL; null = all cohorts
  zoomLink        String? // recurring live link, if online
  isActive        Boolean    @default(true)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  instituteId String?
  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: Restrict)

  generatedSessions ClassSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([instituteId])
  @@index([dayOfWeek])
  @@index([isActive])
}

model StudentBarcode {
  id      String @id @default(uuid())
  barcode String // institute-issued scan code (as entered by the student)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instituteId, barcode]) // unique WITHIN an institute (not globally)
  @@unique([userId, instituteId]) // one barcode per student per institute
  @@index([userId])
  @@index([instituteId])
}
